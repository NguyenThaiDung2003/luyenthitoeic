# Chuỗi kết nối CSDL phát triển trong docker-compose.yml
DATABASE_URL=postgresql://toeic:toeic_dev@localhost:5434/toeic
# CSDL riêng cho test
TEST_DATABASE_URL=postgresql://toeic:toeic_dev@localhost:5434/toeic_test
# Khóa ký JWT, npm run dev tự sinh giá trị ngẫu nhiên
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=7200
PORT=3001
# Nguồn được phép gọi API trực tiếp
FRONTEND_ORIGIN=http://localhost:3002
# Tài khoản giáo viên tạo bởi seed, đặt mật khẩu trước khi dùng ngoài máy phát triển
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=change-me-teacher
# Số lần gọi mỗi phút theo IP
AUTH_RATE_LIMIT=10
GLOBAL_RATE_LIMIT=300
# Số proxy đứng trước backend
TRUST_PROXY_HOPS=1

# Khóa tạo ở Google AI Studio, không đưa lên git
GEMINI_API_KEY=
# Tên model Gemini hỗ trợ đầu ra JSON
GEMINI_MODEL=
# Tên tệp prompt trong backend/prompts, không có đuôi .md
AI_PROMPT_VERSION=explanation-v1
# Số lượt gọi AI mỗi học viên mỗi ngày
AI_DAILY_LIMIT=20
